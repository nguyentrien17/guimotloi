{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guimotloi",
  "compatibility_date": "2026-10-12",
  // Small Worker in front of the static Vite build: hides the admin page
  // behind a secret URL and provides the admin login API (worker/index.js).
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Multi-page site, not an SPA: unknown URLs get a plain 404.
    "not_found_handling": "404-page",
    // Every request hits the Worker first: /admin.html exists as a static
    // file and must not be served publicly, and the secret admin path lives
    // only in a Worker secret, so it can't be listed here.
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
